# Used by docker-compose to pin WAHA's credentials across restarts.
# WAHA auto-generates these on first start if left blank and prints them
# to the container logs - copy them here once, then every future
# `docker-compose up` reuses the same ones instead of generating new ones.
#
# Copy this file to .env and fill in the values WAHA printed on first run.

WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=

# Passed through to the backend service - see whosday-backend/.env.example
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
