PORT=5000

# URL where WAHA is reachable from this backend.
# Local (non-Docker) dev: http://localhost:3000
# Inside docker-compose: http://waha:3000
WAHA_URL=http://localhost:3000

# WAHA session name (default session unless you created a named one)
WAHA_SESSION=default

# Recent WAHA images require this for every /api/* call (401 Unauthorized
# without it). Printed to the container logs / dashboard on first start -
# copy it here so it doesn't need to be re-entered after every restart.
WAHA_API_KEY=

# Supabase - service_role key bypasses Row Level Security, so it can read
# every user's data (needed for the cron that sends on behalf of all users).
# NEVER put SUPABASE_SERVICE_ROLE_KEY in the frontend - backend/.env only,
# and this file must stay gitignored. Find both in Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
